# Vendored writing rules are byte-pinned by their SOURCE.json manifests.
internal/writing/styles/**/*.yml -text
# Preserve this upstream rule's signed-off trailing blank line and hash.
internal/writing/styles/Microsoft/SentenceLength.yml whitespace=-blank-at-eof

# Preserve the pinned grammar dictionary and Apache notice across platforms.
internal/writing/styles/config/dictionaries/harper.dict -text
internal/writing/styles/Harper/LICENSE -text
