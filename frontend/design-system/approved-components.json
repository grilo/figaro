{
  "approvalPolicy": "Adding a component family, primitive, or visual variant requires explicit user approval before implementation.",
  "featureVariants": [
    ".file-tree-node.selected",
    ".file-tree-node.cut-marked"
  ],
  "families": [
    {
      "id": "picker",
      "primitives": [".ui-picker", ".ui-picker-trigger", ".ui-picker-menu"]
    },
    {
      "id": "stepper",
      "primitives": [".ui-stepper", ".ui-stepper-button", ".ui-stepper-value"]
    },
    {
      "id": "button",
      "primitives": [
        ".ui-button",
        ".ui-button--accent",
        ".ui-button--primary",
        ".ui-button--warning",
        ".ui-button--danger",
        ".ui-button--danger-ghost"
      ]
    },
    {
      "id": "icon-button",
      "primitives": [".ui-icon-button", ".ui-icon-button--small", ".ui-icon-button--danger"]
    },
    {
      "id": "badge",
      "primitives": [".ui-badge", ".ui-badge--muted", ".ui-badge--accent", ".ui-badge--warning"]
    },
    {
      "id": "menu",
      "primitives": [".ui-menu", ".ui-menu-item", ".ui-menu-label", ".ui-menu-separator"]
    },
    {
      "id": "tooltip",
      "primitives": [".ui-tooltip"]
    },
    {
      "id": "field",
      "primitives": [".ui-field"]
    },
    {
      "id": "date-picker",
      "primitives": [
        ".ui-date-picker",
        ".ui-date-picker-clear",
        ".ui-date-picker-day",
        ".ui-date-picker-footer",
        ".ui-date-picker-grid",
        ".ui-date-picker-header",
        ".ui-date-picker-shortcuts",
        ".ui-date-picker-weekdays",
        ".ui-date-picker-day--weekend",
        ".ui-date-picker-day--note-1",
        ".ui-date-picker-day--note-2",
        ".ui-date-picker-day--note-3",
        ".ui-date-picker-day--note-4",
        ".ui-date-picker-day--note-5",
        ".ui-date-picker-day--due"
      ]
    },
    {
      "id": "notice",
      "primitives": [
        ".ui-notice",
        ".ui-notice--info",
        ".ui-notice--success",
        ".ui-notice--warning",
        ".ui-notice--danger"
      ]
    },
    {
      "id": "document-tabs",
      "primitives": [
        ".ui-document-tabs",
        ".ui-document-tab",
        ".ui-document-tab--active",
        ".ui-document-tab--dirty",
        ".ui-document-tab--pinned"
      ]
    },
    {
      "id": "editor-fold-control",
      "primitives": [
        ".ui-editor-fold-control",
        ".ui-editor-block-guide",
        ".ui-editor-block-guide--danger"
      ]
    },
    {
      "id": "spinner",
      "primitives": [".ui-spinner"]
    },
    {
      "id": "progress",
      "primitives": [
        ".ui-progress",
        ".ui-progress-value"
      ]
    }
  ]
}
