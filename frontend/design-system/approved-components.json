{
  "approvalPolicy": "Adding a component family, primitive, or visual variant requires explicit user approval before implementation.",
  "featureVariants": [
    ".calendar-timeline-note",
    ".kanban-gantt-bar",
    ".custom-modal--resizable",
    ".file-tree-node.selected",
    ".file-tree-node.cut-marked",
    ".file-tree-node.file-issue--warning",
    ".file-tree-node.file-issue--danger"
  ],
  "families": [
    {
      "id": "disclosure",
      "description": "User-approved Figaro Dark/CRT mockup: visible neutral resting surface, left rotating chevron, trailing summary and a 180 ms in-flow reveal. Closed content is inert and hidden from assistive technology; keyboard focus, disabled/busy, forced-colors and reduced-motion states are explicit.",
      "primitives": [
        ".ui-disclosure",
        ".ui-disclosure-trigger",
        ".ui-disclosure-chevron",
        ".ui-disclosure-label",
        ".ui-disclosure-summary",
        ".ui-disclosure-body",
        ".ui-disclosure-content"
      ]
    },
    {
      "id": "picker",
      "primitives": [
        ".ui-picker",
        ".ui-picker--quiet",
        ".ui-picker-trigger",
        ".ui-picker-menu"
      ]
    },
    {
      "id": "stepper",
      "primitives": [
        ".ui-stepper",
        ".ui-stepper--quiet",
        ".ui-stepper-button",
        ".ui-stepper-value"
      ]
    },
    {
      "id": "button",
      "primitives": [
        ".ui-button",
        ".ui-button--quiet",
        ".ui-button--accent",
        ".ui-button--primary",
        ".ui-button--warning",
        ".ui-button--danger",
        ".ui-button--danger-ghost"
      ]
    },
    {
      "id": "segmented-control",
      "description": "Shared pill-shaped choice controls with a theme-tokenized sliding selection highlight. Keyboard focus and reduced-motion behavior remain explicit.",
      "primitives": [
        ".ui-segmented-control",
        ".ui-segmented-control--quiet"
      ]
    },
    {
      "id": "icon-button",
      "description": "Native-disabled and guarded aria-disabled controls share the existing disabled appearance; aria-disabled remains focusable for explanations and retains the standard focus ring.",
      "primitives": [
        ".ui-icon-button",
        ".ui-icon-button--small",
        ".ui-icon-button--danger"
      ]
    },
    {
      "id": "badge",
      "description": "Existing badges also label partially enabled writing groups; Partial uses the base primitive without a new visual variant.",
      "primitives": [
        ".ui-badge",
        ".ui-badge--muted",
        ".ui-badge--warning"
      ]
    },
    {
      "id": "menu",
      "description": "Existing menu surfaces also host inline writing explanations and quiet Apply, Ignore, and spelling dictionary actions; their controls retain the approved button states.",
      "primitives": [
        ".ui-menu",
        ".ui-menu-item",
        ".ui-menu-label",
        ".ui-menu-separator"
      ]
    },
    {
      "id": "tooltip",
      "primitives": [
        ".ui-tooltip"
      ]
    },
    {
      "id": "field",
      "primitives": [
        ".ui-field",
        ".ui-field--quiet"
      ]
    },
    {
      "id": "checkbox",
      "description": "Writing groups reuse the existing checkbox; preserved subsets expose the native mixed accessibility state and a visible Partial badge. Group coverage is described beside the control.",
      "primitives": [
        ".ui-checkbox"
      ]
    },
    {
      "id": "date-picker",
      "primitives": [
        ".ui-date-picker",
        ".ui-date-picker-clear",
        ".ui-date-picker-day",
        ".ui-date-picker-footer",
        ".ui-date-picker-grid",
        ".ui-date-picker-header",
        ".ui-date-picker-shortcuts",
        ".ui-date-picker-weekdays",
        ".ui-date-picker-day--weekend",
        ".ui-date-picker-day--note-1",
        ".ui-date-picker-day--note-2",
        ".ui-date-picker-day--note-3",
        ".ui-date-picker-day--note-4",
        ".ui-date-picker-day--note-5",
        ".ui-date-picker-day--due"
      ]
    },
    {
      "id": "notice",
      "primitives": [
        ".ui-notice",
        ".ui-notice--info",
        ".ui-notice--success",
        ".ui-notice--warning",
        ".ui-notice--danger"
      ]
    },
    {
      "id": "document-tabs",
      "primitives": [
        ".ui-document-tabs",
        ".ui-document-tabs--titlebar",
        ".ui-document-tab",
        ".ui-document-tab--connected",
        ".ui-document-tab--side-connected",
        ".ui-document-tab--active",
        ".ui-document-tab--dirty",
        ".ui-document-tab--pinned"
      ]
    },
    {
      "id": "editor-fold-control",
      "description": "Existing block reveal states use data-block-control-relevant on the gutter owner so source-offset updates preserve visibility while the pointer remains over the block.",
      "primitives": [
        ".ui-editor-fold-control",
        ".ui-editor-block-guide",
        ".ui-editor-block-guide--danger"
      ]
    },
    {
      "id": "image-resize-handle",
      "primitives": [
        ".ui-image-resize-handle"
      ]
    },
    {
      "id": "graph-canvas",
      "primitives": [
        ".ui-graph-canvas"
      ]
    },
    {
      "id": "spinner",
      "primitives": [
        ".ui-spinner"
      ]
    },
    {
      "id": "skeleton",
      "primitives": [
        ".ui-skeleton"
      ]
    },
    {
      "id": "progress",
      "primitives": [
        ".ui-progress",
        ".ui-progress-value"
      ]
    },
    {
      "id": "suggestion",
      "description": "User-approved rounded, borderless backgrounds visually separate writing suggestions, including grouped identical occurrences. Navigation, disclosure, and individual or bulk actions use existing button states.",
      "primitives": [
        ".ui-suggestion"
      ]
    }
  ]
}
